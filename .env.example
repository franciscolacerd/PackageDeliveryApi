# Copy this file to .env and set the real value (.env is not versioned).
#   cp .env.example .env
#
# Password for the SQL Server 'sa' account in the container. Required policy:
# 8+ characters with at least 3 of: uppercase, lowercase, digit, symbol.
# Without a valid password the SQL container will not start.
MSSQL_SA_PASSWORD=Your_strong_Pass123!
JWT_SIGNING_KEY=CHANGE_ME_super_secret_signing_key_at_least_64_chars_long_for_HmacSha512_0123456789
