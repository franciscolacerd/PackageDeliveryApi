{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "PackageDeliveryConnection": "Server=.\\SQLEXPRESS;Database=PackageDelivery;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "TokenProviderOptions": {
    "SecretKey": "CHANGE_ME_super_secret_signing_key_at_least_64_chars_long_for_HmacSha512_0123456789",
    "Issuer": "PackageDelivery Api",
    "Audience": "https://localhost:7280",
    "TokenPath": "/token",
    "CookieName": "access_token"
  },
  "BaseUrl": {
    "Uri": "https://localhost:7280"
  },
  "RateLimiting": {
    "Fixed": {
      "PermitLimit": 100,
      "WindowSeconds": 60,
      "QueueLimit": 2
    },
    "Authenticated": {
      "TokenLimit": 300,
      "ReplenishSeconds": 10,
      "TokensPerPeriod": 30,
      "QueueLimit": 10
    },
    "PerIp": {
      "PermitLimit": 60,
      "WindowSeconds": 60
    }
  }
}
