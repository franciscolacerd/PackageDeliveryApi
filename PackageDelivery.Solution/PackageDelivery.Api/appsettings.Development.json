{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": { "AllowedOrigins": [ "https://localhost:5173" ] },
  "TokenProviderOptions": {
    "SecretKey": "CHANGE_ME_super_secret_signing_key_at_least_64_chars_long_for_HmacSha512_0123456789",
    "Issuer": "PackageDelivery Api",
    "Audience": "https://localhost:7280",
    "CookieName": "access_token",
    "Expiration": 30,
    "RefreshTokenExpirationDays": 7,
    "CookieSecure": true
  },
  "BaseUrl": {
    "Uri": "https://localhost:7280"
  },
  "RateLimiting": {
    "Authenticated": {
      "TokenLimit": 300,
      "ReplenishSeconds": 10,
      "TokensPerPeriod": 30,
      "QueueLimit": 10
    },
    "PerIp": {
      "PermitLimit": 60,
      "WindowSeconds": 60
    }
  }
}