{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "C:/Logs/PackageDelivery.Api/PackageDeliveryApi.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "Cors": { "AllowedOrigins": [] },
  "TokenProviderOptions": {
    "SecretKey": "CHANGE_ME_super_secret_signing_key_at_least_64_chars_long_for_HmacSha512_0123456789",
    "Issuer": "PackageDelivery Api",
    "Audience": "https://localhost:7280",
    "CookieName": "access_token",
    "Expiration": 30,
    "RefreshTokenExpirationDays": 7,
    "CookieSecure": true
  },
  "BaseUrl": {
    "Uri": "https://localhost:7280"
  },
  "RateLimiting": {
    "Authenticated": {
      "TokenLimit": 300,
      "ReplenishSeconds": 10,
      "TokensPerPeriod": 30,
      "QueueLimit": 10
    },
    "PerIp": {
      "PermitLimit": 60,
      "WindowSeconds": 60
    }
  },
  "PagingSettings": {
    "MaxPageSize": 100
  }
}